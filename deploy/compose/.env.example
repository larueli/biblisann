# Settings for compose.example.yaml. Every BIBLISANN_* variable is documented in docs/user/configuration.md.
# Sensitive values (database URL, secret key, SMTP password, tokens...) do NOT go here: use
# BIBLISANN_<NAME>_FILE with a Compose secret.

# Image version to run (a release tag without the leading v, for example 0.1.0).
BIBLISANN_VERSION=

# Public address users type in the browser, no path. https turns on HSTS and is required for passkeys.
BIBLISANN_BASE_URL=https://books.example.org

# Address of your reverse proxy (CIDR or IP), so client IPs in logs and rate limits are right.
BIBLISANN_TRUSTED_PROXIES=172.16.0.0/12

# first-user (default), open, or closed.
BIBLISANN_REGISTRATION=first-user

# Metadata providers, in priority order. Each lookup sends an ISBN to the provider.
BIBLISANN_PROVIDERS=bnf,openlibrary

# Outgoing email (password reset, loan reminders). Uncomment and set BIBLISANN_SMTP_PASSWORD_FILE if needed.
# BIBLISANN_SMTP_HOST=smtp.example.org
# BIBLISANN_SMTP_PORT=587
# BIBLISANN_SMTP_USERNAME=biblisann
# BIBLISANN_SMTP_FROM=biblisann@example.org

# Single sign-on (OIDC). The client secret goes in BIBLISANN_OIDC_CLIENT_SECRET_FILE.
# BIBLISANN_OIDC_ISSUER=https://id.example.org
# BIBLISANN_OIDC_CLIENT_ID=biblisann

BIBLISANN_LOG_LEVEL=info
